---
export const prerender = false;

import OpsLayout from '../../layouts/OpsLayout.astro';
import forecastSnapshot from '../../data/forecast-latest.json';
import eventIntel from '../../data/event-intel-latest.json';

type ForecastRow = {
  date: string;
  weekday: string;
  days_until: number;
  samples: number;
  on_books_bookings: number;
  on_books_guests: number;
  baseline_bookings: number;
  baseline_guests: number;
  forecast_bookings_low: number;
  forecast_bookings_base: number;
  forecast_bookings_high: number;
  forecast_guests_low: number;
  forecast_guests_base: number;
  forecast_guests_high: number;
  forecast_gross_base: number;
  staffing: string;
  external_events: string;
  expected_rooms: number;
  concurrent_staff_needed: number;
  staff_availability: number;
  blocking_risk: number;
  blocked_gross_potential: number;
  windows?: ForecastWindow[];
};

type ForecastWindow = {
  label: string;
  planned_staff: number;
  staffing_note: string;
  samples: number;
  on_books_room_starts: number;
  on_books_guests: number;
  baseline_room_starts: number;
  forecast_room_starts_base: number;
  forecast_room_starts_high: number;
  staff_needed_estimate: number;
  coverage_gap: number;
  blocking_risk: number;
  blocked_gross_potential: number;
};

type EventIntel = {
  event_name: string;
  start_date: string;
  end_date: string;
  location: string;
  distance_miles_estimate: number;
  event_type: string;
  expected_attendance: number | null;
  audience_fit: string;
  expected_uplift_bookings: number | null;
  expected_uplift_guests: number | null;
  confidence: number;
  source_url: string;
  research_notes: string;
  status: string;
  created_at: string;
  source_name?: string | null;
};

const rows = (forecastSnapshot.forecast ?? []) as ForecastRow[];
const events = (eventIntel ?? []) as EventIntel[];
const metadata = forecastSnapshot.metadata ?? {};
const chronologicalWindow = [...rows].sort((a, b) => a.days_until - b.days_until).slice(0, 7);

const riskLevel = (row: ForecastRow) => {
  const hasCoverageGap = row.concurrent_staff_needed > row.staff_availability && row.blocking_risk > 0;
  if (hasCoverageGap || row.blocking_risk >= 0.25) return 'high';
  if (row.concurrent_staff_needed === row.staff_availability || row.samples === 0 || row.external_events) return 'watch';
  return 'covered';
};

const riskSeverity = (row: ForecastRow) => {
  const level = riskLevel(row);
  if (level === 'high') return 3;
  if (level === 'watch') return 2;
  return 1;
};

const reviewSortedRows = [...chronologicalWindow].sort((a, b) => {
  const severityDelta = riskSeverity(b) - riskSeverity(a);
  if (severityDelta !== 0) return severityDelta;
  return a.days_until - b.days_until;
});

const nextSeven = reviewSortedRows;

const riskLabel = (row: ForecastRow) => {
  const level = riskLevel(row);
  if (level === 'high') return 'Coverage gap likely';
  if (level === 'watch') return row.samples === 0 ? 'Needs review' : 'Coverage gap possible';
  return 'Covered';
};

const shortRiskLabel = (row: ForecastRow) => {
  const level = riskLevel(row);
  if (level === 'high') return 'High Risk';
  if (level === 'watch') return 'Watch';
  return 'Covered';
};

const riskReason = (row: ForecastRow) => {
  if (row.concurrent_staff_needed > row.staff_availability && row.blocking_risk > 0) {
    return `Likely ${row.concurrent_staff_needed} room overlap, ${row.staff_availability} staff coverage planned.`;
  }
  if (row.weekday === 'Monday' && row.staff_availability === 0 && row.concurrent_staff_needed === 0) {
    return 'Closed/manual day: historical bookings are treated as pre-planned coverage, not a staffing gap.';
  }
  if (row.samples === 0) {
    return 'Generated from scaffold data; live historical samples are not loaded yet.';
  }
  if (row.external_events) {
    return 'Event context may lift demand before bookings appear.';
  }
  return 'Planned coverage appears to match likely room concurrency.';
};

const operatingWindowLabel = (row: ForecastRow) => {
  if (['Tuesday', 'Wednesday'].includes(row.weekday)) {
    return 'Appointment-only window: 5-11 PM; last booking 10 PM; bookings require at least 2 hours notice.';
  }
  if (row.weekday === 'Thursday') {
    return 'Operating window: 5-11 PM; last booking 10 PM.';
  }
  if (row.weekday === 'Friday') {
    return 'Review windows: 12-5 PM early coverage with one staff onsite, then 5-11 PM close; last booking 10 PM.';
  }
  if (row.weekday === 'Saturday') {
    return 'Review windows: 12-5 PM early coverage, then 5-11 PM close; last booking 10 PM.';
  }
  if (row.weekday === 'Sunday') {
    return 'Review windows: 12-5 PM early coverage, then 5-10 PM close; last booking 9 PM.';
  }
  return 'Closed or appointment-only context should be confirmed before staffing changes.';
};

const staffCoverageLabel = (row: ForecastRow) => {
  if ((metadata.loaded_rows ?? 0) === 0) {
    return 'Scaffold coverage placeholder';
  }
  return `${row.staff_availability} staff coverage input`;
};

const riskClass = (row: ForecastRow) => {
  const level = riskLevel(row);
  if (level === 'high') return 'border-red-400/40 bg-red-500/15 text-red-100';
  if (level === 'watch') return 'border-amber-400/40 bg-amber-500/15 text-amber-100';
  return 'border-emerald-400/40 bg-emerald-500/15 text-emerald-100';
};

const formatDate = (value: string) => new Date(`${value}T12:00:00`).toLocaleDateString('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
});

const highRiskRows = nextSeven.filter((row) => riskLevel(row) === 'high');
const watchRows = nextSeven.filter((row) => riskLevel(row) === 'watch');
const highestRiskDay = highRiskRows[0] ?? watchRows[0] ?? nextSeven[0];
const weekendRows = reviewSortedRows.filter((row) => ['Saturday', 'Sunday'].includes(row.weekday));
const nextWeekendCoverage = weekendRows[0] ? `${shortRiskLabel(weekendRows[0])} ${weekendRows[0].weekday}` : 'No weekend rows';
const blockedRiskTotal = nextSeven.reduce((sum, row) => sum + (row.blocked_gross_potential || 0), 0);
const eventSummary = events.length === 0
  ? 'No candidate events'
  : `${events.length} candidate event${events.length === 1 ? '' : 's'}`;
const highConfidenceEvents = events.filter((event) => event.confidence >= 0.8).length;
---

<OpsLayout
  title="TFI Ops — Staff Coverage Forecast"
  subtitle="Room demand, staff coverage, and blocked-revenue risk for The Escape Adventures."
>
  <section class="mb-8 rounded-3xl border border-navy-700/80 bg-navy-800/80 p-6 shadow-2xl shadow-navy-900/30 lg:p-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.28em] text-gold-400">Private ops pilot</p>
        <h1 class="text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl">Staff Coverage Forecast</h1>
        <p class="mt-3 text-lg leading-relaxed text-slate-300">Room demand, staff coverage, and blocked-revenue risk for The Escape Adventures.</p>
      </div>
      <div class="grid gap-2 text-sm text-slate-400 sm:grid-cols-2 lg:min-w-[28rem]">
        <div><span class="text-slate-200">Generated:</span> {metadata.generated_date ?? 'Unknown'}</div>
        <div><span class="text-slate-200">Source:</span> Sales - Pabbly Staging</div>
        <div><span class="text-slate-200">Model version:</span> {metadata.model_version ?? 'Unknown'}</div>
        <div><span class="text-slate-200">Privacy:</span> no customer names, emails, phone numbers, or payment data</div>
      </div>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#forecast-table" class="rounded-full bg-gold-500 px-4 py-2 text-sm font-semibold text-navy-900 hover:bg-gold-400">Review high-risk days</a>
      <a href="#event-inbox" class="rounded-full border border-navy-600 px-4 py-2 text-sm font-semibold text-slate-200 hover:border-gold-500/60">Open event inbox</a>
    </div>
  </section>

  <section aria-label="Forecast summary" class="mb-8 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
    <article class="rounded-2xl border border-navy-700 bg-navy-800/70 p-5">
      <p class="text-sm text-slate-400">Highest-risk day</p>
      <p class="mt-2 text-2xl font-bold text-slate-100">{highestRiskDay ? highestRiskDay.weekday : 'No data'}</p>
      <p class="mt-2 text-sm text-amber-100">{highestRiskDay ? riskReason(highestRiskDay) : 'No forecast artifact is available yet.'}</p>
    </article>
    <article class="rounded-2xl border border-navy-700 bg-navy-800/70 p-5">
      <p class="text-sm text-slate-400">Blocked-revenue risk</p>
      <p class="mt-2 text-2xl font-bold text-slate-100">{blockedRiskTotal > 0 ? `$${Math.round(blockedRiskTotal)}` : '0 likely blocked starts'}</p>
      <p class="mt-2 text-sm text-slate-400">Count-based substitute shown when revenue estimate is unavailable.</p>
    </article>
    <article class="rounded-2xl border border-navy-700 bg-navy-800/70 p-5">
      <p class="text-sm text-slate-400">Next weekend coverage</p>
      <p class="mt-2 text-2xl font-bold text-slate-100">{nextWeekendCoverage}</p>
      <p class="mt-2 text-sm text-slate-400">Review mid-day room overlap before staffing changes.</p>
    </article>
    <article class="rounded-2xl border border-navy-700 bg-navy-800/70 p-5">
      <p class="text-sm text-slate-400">Event surge flags</p>
      <p class="mt-2 text-2xl font-bold text-slate-100">{eventSummary}</p>
      <p class="mt-2 text-sm text-slate-400">{highConfidenceEvents} high-confidence events within current seed data.</p>
    </article>
    <article class="rounded-2xl border border-navy-700 bg-navy-800/70 p-5">
      <p class="text-sm text-slate-400">Forecast confidence</p>
      <p class="mt-2 text-2xl font-bold text-slate-100">{metadata.loaded_rows > 0 ? 'Medium' : 'Scaffold'}</p>
      <p class="mt-2 text-sm text-slate-400">Based on on-books demand, historical pattern, event notes, and artifact freshness.</p>
    </article>
  </section>

  <section id="forecast-table" class="mb-8 rounded-3xl border border-navy-700 bg-navy-800/80 p-5 lg:p-6">
    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold text-slate-100">Upcoming days</h2>
        <p class="text-sm text-slate-400">Sorted for operator review. Risk is based on expected room/staff concurrency, not guest count alone.</p>
      </div>
      <p class="text-sm text-slate-400">Showing next {nextSeven.length} days from the current safe artifact.</p>
    </div>

    {nextSeven.length === 0 ? (
      <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 text-amber-100">No forecast data: run the forecast publish job and refresh this dashboard.</div>
    ) : (
      <div class="overflow-x-auto">
        <table class="min-w-full border-separate border-spacing-y-3 text-left text-sm">
          <thead class="text-xs uppercase tracking-wide text-slate-400">
            <tr>
              <th class="px-3 py-2">Day</th>
              <th class="px-3 py-2">On books</th>
              <th class="px-3 py-2">Likely room demand</th>
              <th class="px-3 py-2">Planned staff coverage</th>
              <th class="px-3 py-2">Staffing risk</th>
              <th class="px-3 py-2">Blocked-revenue risk</th>
              <th class="px-3 py-2">Event flags</th>
              <th class="px-3 py-2">Details</th>
            </tr>
          </thead>
          <tbody>
            {nextSeven.map((row) => (
              <tr class="align-top">
                <td class="rounded-l-xl bg-navy-900/70 px-3 py-4 font-semibold text-slate-100">{formatDate(row.date)}</td>
                <td class="bg-navy-900/70 px-3 py-4">{row.on_books_bookings} bookings<br /><span class="text-slate-400">{row.on_books_guests} guests</span></td>
                <td class="bg-navy-900/70 px-3 py-4">{row.expected_rooms} expected rooms<br /><span class="text-slate-400">{row.concurrent_staff_needed} concurrent staff needed</span></td>
                <td class="bg-navy-900/70 px-3 py-4">{staffCoverageLabel(row)}<br /><span class="text-slate-400">{row.staffing}</span></td>
                <td class="bg-navy-900/70 px-3 py-4"><span class={`inline-flex rounded-full border px-3 py-1 text-xs font-semibold ${riskClass(row)}`}>{riskLabel(row)}</span><p class="mt-2 max-w-xs text-slate-400">{riskReason(row)}</p></td>
                <td class="bg-navy-900/70 px-3 py-4">{row.blocked_gross_potential > 0 ? `$${row.blocked_gross_potential}` : '0 likely blocked starts'}</td>
                <td class="bg-navy-900/70 px-3 py-4">{row.external_events ? row.external_events : <span class="text-slate-500">No event flag</span>}</td>
                <td class="rounded-r-xl bg-navy-900/70 px-3 py-4"><a href={`#day-${row.date}`} class="text-gold-300 hover:text-gold-400">Review day</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <section class="mb-8 grid gap-4 lg:grid-cols-2">
    {nextSeven.map((row) => (
      <details id={`day-${row.date}`} class="rounded-2xl border border-navy-700 bg-navy-800/70 p-5">
        <summary class="cursor-pointer list-none text-lg font-semibold text-slate-100">
          {formatDate(row.date)} — {riskLabel(row)}
          <span class="ml-2 text-sm font-normal text-slate-400">{riskReason(row)}</span>
        </summary>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="text-xs uppercase text-slate-400">
              <tr>
                <th class="py-2 pr-4">Time window</th>
                <th class="py-2 pr-4">Forecast room starts</th>
                <th class="py-2 pr-4">On-books rooms</th>
                <th class="py-2 pr-4">Planned coverage</th>
                <th class="py-2 pr-4">Coverage gap</th>
                <th class="py-2 pr-4">Confidence</th>
              </tr>
            </thead>
            <tbody class="text-slate-300">
              {(row.windows?.length ? row.windows : [{
                label: operatingWindowLabel(row),
                planned_staff: row.staff_availability,
                staffing_note: row.staffing,
                samples: row.samples,
                on_books_room_starts: row.on_books_bookings,
                on_books_guests: row.on_books_guests,
                baseline_room_starts: row.baseline_bookings,
                forecast_room_starts_base: row.expected_rooms,
                forecast_room_starts_high: row.forecast_bookings_high,
                staff_needed_estimate: row.concurrent_staff_needed,
                coverage_gap: Math.max(0, row.concurrent_staff_needed - row.staff_availability),
                blocking_risk: row.blocking_risk,
                blocked_gross_potential: row.blocked_gross_potential,
              }]).map((window) => (
                <tr class="border-t border-navy-700">
                  <td class="py-3 pr-4">{window.label}<br /><span class="text-slate-500">{window.staffing_note}</span></td>
                  <td class="py-3 pr-4">{window.forecast_room_starts_base} likely starts<br /><span class="text-slate-500">high estimate {window.forecast_room_starts_high}</span></td>
                  <td class="py-3 pr-4">{window.on_books_room_starts} starts / {window.on_books_guests} guests<br /><span class="text-slate-500">aggregate only; no customer data</span></td>
                  <td class="py-3 pr-4">{window.planned_staff} staff planned</td>
                  <td class="py-3 pr-4">{window.coverage_gap} staff coverage gap</td>
                  <td class="py-3 pr-4">{window.samples > 0 ? 'Medium' : 'Low'} — {window.samples} historical samples; use as a watch item, not a staffing command.</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-slate-400">Blocked-revenue risk estimates room starts that may become unavailable when staffing is below likely room concurrency. It is not guaranteed lost revenue; it is a warning that the booking engine may prevent customers from selecting otherwise sellable times.</p>
      </details>
    ))}
  </section>

  <section id="event-inbox" class="mb-8 rounded-3xl border border-navy-700 bg-navy-800/80 p-5 lg:p-6">
    <h2 class="text-2xl font-bold text-slate-100">Event Intelligence Inbox</h2>
    <p class="mt-2 text-sm text-slate-400">Candidate local events within 30 miles that may affect escape-room demand.</p>
    {events.length === 0 ? (
      <div class="mt-5 rounded-xl border border-navy-600 bg-navy-900/70 p-4 text-slate-300">No event candidates found for this forecast period. Weekly research may still update this panel.</div>
    ) : (
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {events.map((event) => (
          <article class="rounded-xl border border-navy-600 bg-navy-900/70 p-4">
            <h3 class="text-lg font-semibold text-slate-100">{event.event_name}</h3>
            <p class="mt-1 text-sm text-slate-400">{event.start_date} to {event.end_date} · {event.location} · {event.distance_miles_estimate} mi</p>
            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              <span class="rounded-full border border-gold-500/30 bg-gold-500/10 px-2 py-1 text-gold-200">{event.event_type}</span>
              <span class="rounded-full border border-navy-600 px-2 py-1 text-slate-300">Confidence {Math.round(event.confidence * 100)}%</span>
              <span class="rounded-full border border-navy-600 px-2 py-1 text-slate-300">{event.status}</span>
            </div>
            <p class="mt-3 text-sm text-slate-300">Suggested uplift: +{event.expected_uplift_bookings ?? 0} bookings / +{event.expected_uplift_guests ?? 0} guests; audience fit {event.audience_fit}.</p>
            <p class="mt-2 text-sm text-slate-400">{event.research_notes}</p>
            <a href={event.source_url} target="_blank" rel="noreferrer" class="mt-3 inline-block text-sm text-gold-300 hover:text-gold-400">Open event source</a>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <article class="rounded-3xl border border-navy-700 bg-navy-800/80 p-5 lg:p-6">
      <h2 class="text-xl font-bold text-slate-100">Model notes and privacy</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-300">This forecast estimates room/staff pressure, not just guest count. It compares current bookings, historical demand patterns, local event notes, and planned staffing coverage. Risk flags are decision aids; they should be reviewed with operator judgment before changing staffing.</p>
      <p class="mt-3 text-sm leading-relaxed text-slate-300">This dashboard uses aggregate booking and forecast data only. It should not contain customer names, contact details, payment data, or private booking notes.</p>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        <li>Loaded rows in current artifact: {metadata.loaded_rows ?? 'unknown'}</li>
        <li>External events in forecast model: {metadata.external_events ?? 0}</li>
        <li>Current limit: staffing values are planning assumptions until a live staffing-plan artifact is approved.</li>
      </ul>
    </article>
    <article class="rounded-3xl border border-navy-700 bg-navy-800/80 p-5 lg:p-6">
      <h2 class="text-xl font-bold text-slate-100">Latest retrospective</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-300">No retrospective artifact is available yet. Once weekend review reports exist, this panel should summarize forecast-vs-actual, event note impact, and model adjustment notes.</p>
      <p class="mt-4 rounded-xl border border-navy-600 bg-navy-900/70 p-4 text-sm text-slate-400">Empty state: add aggregate actual-vs-forecast counts only. Do not add customer details, private booking notes, or payment data.</p>
    </article>
  </section>
</OpsLayout>
